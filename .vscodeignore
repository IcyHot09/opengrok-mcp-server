# Controls what gets included in the VSIX package

# Exclude development files
.gitignore
.vscode/
src/
*.ts
tsconfig.json
esbuild.js
node_modules/
.vscode-test/
package-lock.json

# Exclude extra documentation (README.md + LICENSE ship with the extension)
AGENTS.md
CONTRIBUTING.md
CHANGELOG.md
ENGINEERING.md
SECURITY.md
MCP_CLIENTS.md

# Dev build sourcemaps — never ship in the VSIX (release builds disable them,
# but a local `npm run compile` before `npm run vsix` would otherwise leak them)
**/*.map

# Local env files — may contain secrets, never ship (template included: not needed at runtime)
.env*

# Package artifacts must never be bundled into themselves
*.vsix
*.tgz

# Exclude backups
*.bak

# Exclude credential and token files — must never be in a VSIX
.mcpregistry_*
*.token
*.secret

# Exclude vitest config
vitest.config.ts

# Exclude coverage reports and local logs
coverage/
*.log

# Exclude eslint config
eslint.config.mjs

# Exclude nvmrc
.nvmrc

# Exclude platform archives (standalone distribution, not part of VS Code extension)
*.tar.gz
*.zip

# Exclude unrelated CI/infra
.github/

# Exclude standalone scripts
scripts/

# Exclude grammar source staging dir — runtime loads from out/grammars/, not grammars/
grammars/

# Exclude npm packaging metadata — meaningless inside a VSIX
.npmignore

# Exclude evaluation / skills / local docs
evaluation.xml
skills/
docs/
CLAUDE.md
server.json

# Exclude sandbox vitest config
vitest.sandbox.config.ts

# Exclude local tool directories
.opengrok/

# Include only production files:
# out/, images/, package.json, README.md, LICENSE
