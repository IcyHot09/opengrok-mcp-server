{
  "compilerOptions": {
    "module": "es2022",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".vscode-test", "src/tests/**"]
}
